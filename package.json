{
  "name": "@swissconnection/render-agent-log",
  "version": "0.0.0",
  "private": true,
  "description": "Render agent runs as readable, colored, collapsible logs in the GitHub Actions UI",
  "license": "MIT",
  "repository": "github:SwissConnection/render-agent-log",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js",
    "typecheck": "tsc",
    "lint": "biome check",
    "fix": "biome check --write",
    "test": "vitest run"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
