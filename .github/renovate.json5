{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // One daily PR: Claude's packages move almost every weekday anyway (#22)
  dependencyDashboard: false,
  separateMajorMinor: false,
  minimumReleaseAge: "3 days",
  // Its checks run the workflows on its branch, so they stay main's
  rebaseWhen: "behind-base-branch",
  packageRules: [
    {
      matchPackageNames: ["*"],
      groupName: "all dependencies",
      groupSlug: "all",
    },
    {
      // The Action's runtime is node24 (action.yml)
      matchPackageNames: ["@types/node"],
      allowedVersions: "<25",
    },
  ],

  prBodyTemplate: "<!-- dependencies.yml writes this description (.github/scripts/dependency-note.sh). -->{{{warnings}}}",
  fetchChangeLogs: "off",
}
