#!/usr/bin/env bash
# Stand-in for claude, passed to claude-code-action as path_to_claude_code_executable. It runs the real
# claude on the SDK's own stdin and stderr, passes its stdout through unchanged, and tees a copy through
# render.py into the step's log. Linux only: it writes to the parent's stdout through /proc.
#
# Gotchas:
# - The action prepends this directory to PATH, for the agent's Bash tool and for every later step.
#   That is why the file is not called claude and sits alone in bin/.
# - The action also runs this path for other subcommands (plugin install). Only the SDK's query passes
#   --output-format stream-json, so everything else goes straight to the real claude.
set -euo pipefail

# The native claude the SDK bundles, which the action installs with it: the version always matches the
# SDK's, so there is no separate install to pin and keep in step with the action.
arch=$(uname -m | sed 's/x86_64/x64/; s/aarch64/arm64/')
real=${SPIKE_REAL_CLAUDE:-$GITHUB_ACTION_PATH/node_modules/@anthropic-ai/claude-agent-sdk-linux-$arch/claude}
case " $* " in
  *" --output-format stream-json "*) ;;
  *) exec "$real" "$@" ;;
esac

spike=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# The SDK spawns this script from the action's bun process, whose stdout is the step's log.
log=/proc/$PPID/fd/1
own=$(readlink /proc/$$/fd/1)
{
  printf '\e[90mwrapper: pid %s, parent %s (%s), parent stdout %s, own stdout %s, render_dies=%s\e[0m\n' \
    "$$" "$PPID" "$(ps -o comm= -p "$PPID")" "$(readlink "$log")" "$own" \
    "${SPIKE_RENDER_DIE:-unset}"
  printf '\e[90mwrapper: claude %s at %s\e[0m\n' "$("$real" --version)" "$real"
  # Ancestors by name only: argv carries the SDK's --mcp-config, token included.
  pid=$$
  while [ "$pid" -gt 1 ]; do
    printf '\e[90m  %s\e[0m\n' "$(ps -o pid=,comm= -p "$pid")"
    pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
  done
} >"$log"

# A renderer that dies inside a stopped block leaves every later workflow command in the step inert,
# the action's own ::error:: included, so the supervisor holds the token and closes the block for it.
# The token is not exported: claude, and so the agent's Bash tool, never sees it.
token=$(openssl rand -hex 16)
render() {
  SPIKE_STOP_TOKEN=$token python3 "$spike/render.py" || printf '::%s::\n::endgroup::\n' "$token"
}
# tee -p ignores SIGPIPE and drops an output whose reader went away, so a dead renderer cannot stop the
# stream the SDK reads. The raw copy lets a later step compare what the SDK got with what was rendered.
exec > >(tee -p "${RUNNER_TEMP:-/tmp}/claude-wrapper-stream.jsonl" >(render >"$log" 2>&1) 2>"$log")
# exec keeps this PID for the real claude, so the SDK's SIGTERM and exit code reach it, not a shell.
exec "$real" "$@"
