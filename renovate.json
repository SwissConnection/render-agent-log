{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["* * * * 1"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 1"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Tooling updates merge themselves once CI is green",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "The Action runs on node24: Node and its types stay on 24",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "The SDK's types are the input contract. A failing typecheck on this PR means a message type changed, and that is the work item",
      "matchPackageNames": ["@anthropic-ai/claude-agent-sdk"],
      "automerge": false
    }
  ]
}
